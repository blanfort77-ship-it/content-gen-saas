{
  "name": "content-gen-saas",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/core",
    "packages/api"
  ],
  "scripts": {
    "build": "npm run build --workspace=@content-gen/core && npm run build --workspace=@content-gen/api",
    "dev:api": "npm run dev --workspace=@content-gen/api",
    "test": "npm test --workspace=@content-gen/core"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "prisma@5.22.0": true
  }
}
